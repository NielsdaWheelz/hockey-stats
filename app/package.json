{
  "name": "hockey-stats",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "capture": "tsx src/operator/cli.ts",
    "capture-season": "tsx src/operator/capture-season-cli.ts",
    "publication": "tsx src/operator/publication-cli.ts",
    "build": "react-router build && tsc -p tsconfig.json --noEmit false --outDir dist/node",
    "serve": "node dist/node/server/main.js",
    "dev:api": "tsx src/server/main.ts --api-only",
    "dev:web": "react-router dev",
    "typecheck": "react-router typegen && tsc -p tsconfig.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "@effect/sql-sqlite-node": "4.0.5",
    "effect": "4.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "@react-router/node": "8.4.0",
    "isbot": "5.2.2"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@react-router/dev": "8.4.0",
    "vite": "8.3.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
