  "semantics": {
    "e": "hours",
    "H": "rate times exposure-residualized design gram",
    "selection": "current rows by union rows",
    "raw": "physical zero-sum native maps before role exposure centering",
    "operator_0": "five-component native map",
    "operator_1": "redistribution into native cells zero and four",
    "operator_2": "signed half mass across cells zero through three",
    "full_score_order": "union player-role row then spatial coefficient",
    "full_score_context_order": "score row/coefficient then stratum/native cell"
  },
  "independent_oracle": {
    "physical_mean": "mu_ij = rate*e_i*(p_j + alpha*(X*raw)_ij)",
    "gaussian": "count covariance = diag(rate*e_i*p_j)",
    "game_pace": "count covariance = diag(mu) + .5*sum_game outer(vec(mu_game),vec(mu_game)); both game directions share pace",
    "score_map": "each count (i,j) has score column vec(outer((X_i-xbar_si)*selection, B_j))",
    "context_map": "each final count (i,j) contributes native context cell (si,j) with factor 1/(rate*final_stratum_exposure)",
    "contractions": "transform the full count covariance through score/context maps, then sum equal spatial-coefficient diagonals",
    "copies": "multiply full score covariance, H and m by copies; divide final context by copies*exposure; context cross-score stays unchanged",
    "duration": "doubling e doubles diagonal covariance but quadruples each shared-pace outer product",
    "prediction": "transform score covariance to current fitted native maps via kron(selection*K,R), then contract explicit evaluation rows with exposure weights and inverse shares"
  },
  "checked_facts": [
    "all 121 moment, fixed-risk and signed prediction comparisons pass",
    "raw physical exposure means are nonzero; exposure-centering raw inputs changes the game-pace law",
    "fixed null contractions agree exactly between both laws",
    "independent game copies and doubled shared-pace duration have equal information/mean and unequal covariance",
    "native truth contains omitted basis detail; replacing actual regional truth by its projection changes bias"
  ]
}
