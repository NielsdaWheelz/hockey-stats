      "expected": {"phase": "absent", "complete_proxy": true, "excluded_candidate": 4,
                   "prior": {"none": 0.2, "2": 0.32, "3": 0.32, "9": 0.16}}
    },
    {
      "name": "return_at_focal_clock_is_excluded",
      "intervals": [
