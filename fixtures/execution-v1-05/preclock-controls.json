      "records": [
        {"source_index": 0, "order": 0, "clock": 0, "kind": "period-start", "valid": true},
        {"source_index": 2, "order": 1, "clock": 20, "kind": "goal", "valid": true}
      ],
      "expected": {"transition": {"exists": false, "side": null, "age": null}}
    },
    {
      "name": "unknown_prior_clock_and_period_are_a_barrier",
      "records": [
        {"source_index": 0, "order": 0, "clock": 0, "kind": "period-start", "valid": true},
        {"source_index": 1, "order": 1, "period": null, "clock": null, "kind": "unknown", "valid": false},
        {"source_index": 2, "order": 2, "clock": 20, "kind": "goal", "valid": true}
