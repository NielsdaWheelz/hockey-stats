#!/bin/bash
set -euo pipefail
cd /Users/nnandal/Documents/code/hockey-stats-v1-08

test "$(git rev-parse HEAD:analysis)" = 38ec706cb505ea3d9936518dd119869e7695200b
test -z "$(git status --porcelain --untracked-files=all -- analysis)"
test "$(shasum -a 256 var/v1-08-replacement/review_spatial_experimental_consequences.py | cut -d ' ' -f 1)" = 8c1602039fc616ca7f8b26df950800bf9a53b6951b4024e995e26fa42c0315ec
test "$(shasum -a 256 docs/research/spatial-v1-08/experimental-use-policy.md | cut -d ' ' -f 1)" = 4c0f136c46735f48ef76f8202f75388969d5484947faa33d868718b8ff2b0bbb
test "$(shasum -a 256 docs/research/spatial-v1-08/experimental-use-consequence-review.md | cut -d ' ' -f 1)" = e7be8b277996039e6a675c10a86e5153a564f01e9751f16b25477e8fd8f73b98
test "$(shasum -a 256 docs/research/spatial-v1-08/reviews/experimental-use-policy-review.md | cut -d ' ' -f 1)" = 84141a218c18320586d0578b9add6f2a73a27aec04f7555a6dc459a4e9c24495
out=/Volumes/Expansion/hockey-stats/runs/execution-spatial-replacement-20261031-01/real/experimental-use-consequences-01
log=/Volumes/Expansion/hockey-stats/runs/execution-spatial-replacement-20261031-01/real/experimental-use-consequences-01.log
exit_record=/Volumes/Expansion/hockey-stats/runs/execution-spatial-replacement-20261031-01/real/experimental-use-consequences-01-exit.txt
test ! -e "$out"
test ! -e "$log"
test ! -e "$exit_record"
set -C
set +e
/usr/bin/time -l /Users/nnandal/Documents/code/hockey-stats-v1-08/analysis/.venv/bin/python /Users/nnandal/Documents/code/hockey-stats-v1-08/var/v1-08-replacement/review_spatial_experimental_consequences.py --expected-source-sha256 8c1602039fc616ca7f8b26df950800bf9a53b6951b4024e995e26fa42c0315ec --out /Volumes/Expansion/hockey-stats/runs/execution-spatial-replacement-20261031-01/real/experimental-use-consequences-01 > "$log" 2>&1
status=$?
printf '%s\n' "$status" > "$exit_record"
exit "$status"
