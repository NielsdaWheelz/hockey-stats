#!/bin/zsh
# held saved-only check; the failed 01 check and its records remain intact.
set -eu
cd /Users/nnandal/Documents/code/hockey-stats-v1-08
check_root=/Volumes/Expansion/hockey-stats/runs/execution-spatial-replacement-20261031-01/real
check_source=/Users/nnandal/Documents/code/hockey-stats-v1-08/var/v1-08-replacement/verify_real_spatial_compose.py
check_run=$check_root/compose-spatial-saved-check-02
[ "$(git rev-parse HEAD:analysis)" = 52bcae1c68161d4424cec672837e783eaeead673 ]
[ -z "$(git status --porcelain --untracked-files=all -- analysis)" ]
check_pin() {
  if [ "$(shasum -a256 "$1" | cut -d' ' -f1)" != "$2" ]; then print -u2 "pin mismatch: $1; command not launched"; exit 1; fi
}
check_pin "$check_source" c863a97abb0d2763f0a3b09e916fb546aad568a1959a524ef8a28106e5653c20
check_pin "$check_root/results/manifest.json" a40ca1c0291579b773db22294f26998f154309b2b65926f00f901331ef0b17d5
check_pin "$check_root/results/manifest.json.incomplete" f5c467767a45d0b9152a0308e1fc7e407da0d5b465ffdd743baae10918c44521
check_pin "$check_root/states-selection.json" 7ac43cfa0bcf72b449bc9267b19f16eb5ac7d7bf396fd08d9a98200d94549f1c
check_pin "$check_root/spatial-product-admission-02.json" f07d5a6ab23ec8234818958050223177e6b19cb56136972af83ad448faab6b80
for check_target in "$check_run.json" "$check_run.log" "$check_run-exit.txt"; do
  if [ -e "$check_target" ]; then print -u2 "occupied path: $check_target; command not launched"; exit 1; fi
done
set -C
set +e
/usr/bin/time -l /Users/nnandal/Documents/code/hockey-stats-v1-08/analysis/.venv/bin/python "$check_source" > "$check_run.log" 2>&1
check_status=$?
set -e
print -r -- "$check_status" > "$check_run-exit.txt"
exit "$check_status"
